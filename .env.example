# Copie este arquivo para .env e preencha com sua chave
# Obtenha sua API key em: https://platform.kimi.ai/console/api-keys
MOONSHOT_API_KEY=sua_chave_aqui

# Endpoint oficial da API (nao alterar, salvo instrucao da Moonshot)
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Modelo padrao do quickstart Kimi Code
# Alternativas: kimi-k2.7-code-highspeed, kimi-k2.6, kimi-k2.5
KIMI_MODEL=kimi-k2.7-code
